{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "agent.ts",
    "identity.ts",
    "model.ts",
    "tools/**/*.ts",
    "middleware/**/*.ts",
    "scripts/**/*.mts",
    "shared/**/*.ts"
  ]
}
